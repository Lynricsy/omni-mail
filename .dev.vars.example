# Required by the Deploy to Cloudflare setup flow.
SETUP_TOKEN=
SUPER_ADMIN_EMAIL=

# Optional. At least 32 UTF-8 bytes; enables iCloud Hide My Email.
ICLOUD_CREDENTIALS_KEY=

# Optional. At least 32 UTF-8 bytes; enables Gmail with controlled IMAP access.
GMAIL_CREDENTIALS_KEY=

# Optional. At least 32 UTF-8 bytes; enables controlled personal QQ Mail IMAP access.
QQ_MAIL_CREDENTIALS_KEY=
QQ_MAIL_IMAP_ENABLED=true

# Optional. Keep disabled until production Worker validation with a dedicated NAVER account passes.
NAVER_MAIL_CREDENTIALS_KEY=
NAVER_MAIL_IMAP_ENABLED=false

# Optional. At least 32 UTF-8 bytes; enables controlled Microsoft IMAP access.
MICROSOFT_CREDENTIALS_KEY=
MICROSOFT_MAIL_ENABLED=true
